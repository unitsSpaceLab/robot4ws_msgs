<?xml version="1.0"?>
<package format="3">
  <name>robot4ws_msgs</name>
  <version>1.1.0</version>
  <description>A library of custom messages for the 4 Wheels Steering Robot. This package allows to control directly each of the Dynamixel installed, other than get information about Sensors and firmware and software version. </description>
  <maintainer email="simone.cottiga@phd.units.it">Simone Cottiga</maintainer>
  <license>GPLv3</license>
  <author email="matteo.caruso@phd.units.it">Matteo Caruso</author>
  <url>https://github.com/unitsSpaceLab/robot4ws_msgs</url>


  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
    
    <!-- next line is only used by ros_bridge, delete it in the final version -->
    <ros1_bridge mapping_rules="bridge_mapping_rules.yaml"/>
  </export>
</package>
